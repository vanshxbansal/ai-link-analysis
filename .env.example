# --- LLM (Gemini is the recommended provider) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: OpenAI as a last-resort fallback (leave empty to disable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

LLM_TIMEOUT=90
LLM_TEMPERATURE=0.3

# --- Website extraction ---
REQUEST_TIMEOUT=20
MAX_CONTENT_LENGTH=50000
MAX_LLM_CONTENT_CHARS=12000
MAX_EXTRA_PAGES=2

# --- Cache (seconds) ---
CACHE_TTL_SECONDS=3600

APP_ENV=development
LOG_LEVEL=INFO
